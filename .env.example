# Google Sheets Integration
# ID Spreadsheet Google Sheets dùng để lưu trữ dữ liệu nghiên cứu (cấu hình phía server):
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_spreadsheet_id_here"

# Đường dẫn Google Apps Script Webhook (cấu hình phía server - tự động đồng bộ & gửi mail):
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/.../exec"

# Email của Service Account được cấp quyền Chỉnh sửa (Editor) trên Spreadsheet (tùy chọn)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Private key của Service Account
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
